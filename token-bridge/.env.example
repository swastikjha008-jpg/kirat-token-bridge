# Deployer key (NEVER commit the real .env)
PRIVATE_KEY=

# RPC endpoints (only the networks you use)
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/<key>
BASE_RPC_URL=https://sepolia.base.org
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

ETHERSCAN_API_KEY=

# Bridge config
# Comma-separated validator addresses (the relayers that sign transfers)
VALIDATORS=0xValidator1,0xValidator2,0xValidator3
# Signatures required (default: simple majority)
THRESHOLD=2
# Chain id of the OTHER chain (src deploy: destination chain id, dst deploy: home chain id)
REMOTE_CHAIN_ID=84532
# Optional: existing ERC-20 to bridge (otherwise a new Kirat is deployed)
KIRAT_ADDRESS=
INITIAL_SUPPLY=1000000
